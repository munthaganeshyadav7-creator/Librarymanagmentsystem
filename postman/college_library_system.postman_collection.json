              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Search Books by Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?query=Clean Code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                {
                  "key": "query",
                  "value": "Clean Code"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Books by Category",
          "request": {
            "method": "GET",
            "header": [],
