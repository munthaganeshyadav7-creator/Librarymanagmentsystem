# ===================================================================
# Backend Environment Variables (Render Web Service Deployment)
# ===================================================================

# 1. Database Connection URL (MySQL on Aiven, TiDB, Clever Cloud, or Railway)
# Format: jdbc:mysql://<HOST>:<PORT>/<DATABASE_NAME>?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host.aivencloud.com:12345/library_db?useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# 2. Database Username & Password
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# 3. Hibernate Schema Strategy (auto updates tables and schema)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# 4. CORS Allowed Origins (Comma-separated list or wildcard)
# Allows your Vercel domain and local test environments:
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000

# 5. Connection Pool Optimization
DB_POOL_MAX=10
DB_POOL_MIN=2
