# ===================================================================
# College Library Management System - Deployment Environment Config
# ===================================================================

# Database Settings
MYSQL_DATABASE=library_db
MYSQL_ROOT_PASSWORD=1234
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/library_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=1234
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Database Connection Pool (HikariCP)
DB_POOL_MAX=20
DB_POOL_MIN=5

# Backend Server
PORT=8080
SERVER_PORT=8080

# Frontend Configuration
# Leave empty for relative reverse-proxy routing (default in Docker/Nginx)
# Or set to full URL for separate CDN/Vercel/Netlify hosting (e.g. https://api.library.college.edu)
VITE_API_BASE_URL=
